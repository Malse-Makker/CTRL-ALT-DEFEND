# Godot
.godot/
*.translation

# Builds — die horen bij een GitHub Release, niet in de repo
build/
deploy/public/*.zip

# Playtest-feedback van testers: bevat hun opmerkingen en speler-id. Deze repo is
# openbaar, dus die zetten we er bewust niet in.
feedback/

# macOS
.DS_Store

# Feedback-bestemming: bevat de Discord-webhook-URL. Deze repo is openbaar, dus die URL mag
# hier NOOIT in -- dan kan iedereen die GitHub bekijkt het kanaal volspammen zonder ook maar
# de game te downloaden. Het bestand wordt lokaal aangemaakt en gaat alleen mee de build in.
feedback_target.json
